# aios.config -- the kernel options the AIOS appliance requires, as a merge fragment.
#
# Apply over a base config with scripts/kconfig/merge_config.sh (see build_appliance.sh). Two bases:
#   * defconfig   -- reliable boot on QEMU virt; this fragment then just GUARANTEES the AIOS options.
#   * tinyconfig  -- the strict-minimal aspiration; this fragment must then ALSO carry the virt
#                    platform + console + initramfs essentials (it does, below).
#
# Grounded in docs/AIOS_KERNEL_DEPENDENCIES.md (what aios-uk actually calls). Nothing here is
# AIOS-userland config -- the AIOS shell/coreutils/regex/job-control all live ABOVE these primitives.

## --- the AIOS PAL trap + inject + service surface (the only AIOS-specific requirements) ---
CONFIG_CROSS_MEMORY_ATTACH=y    # process_vm_readv/writev: copy syscall buffers across the guest boundary
CONFIG_SECCOMP=y                # the seccomp PAL backend (make PAL=seccomp)
CONFIG_SECCOMP_FILTER=y         # SECCOMP_RET_TRACE filters
CONFIG_PROC_FS=y                # /proc/self/fd -- M4.2/M4.3 confinement path canonicalization
CONFIG_POSIX_TIMERS=y           # clock_gettime (the AIOS wall/monotonic clock)
CONFIG_MULTIUSER=y              # setpgid/setsid -- AIOS job control
CONFIG_FUTEX=y                  # glibc (aios-uk is a normal hosted program)
CONFIG_BINFMT_ELF=y             # the host loads aios-uk + each guest ELF

## --- console + tty (interactive AIOS: a shell, raw mode, ^C/^Z) ---
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y      # QEMU virt console -> ttyAMA0
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_DEVTMPFS=y               # /dev/console for init
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PRINTK=y                 # boot diagnostics

## --- boot the AIOS userland straight from RAM (no disk needed) ---
CONFIG_BLK_DEV_INITRD=y         # initramfs holds /init + /aios-uk + /aiosroot
CONFIG_RD_GZIP=y                # gzipped initramfs cpio

## --- QEMU 'virt' aarch64 platform essentials (already in defconfig; required atop tinyconfig) ---
CONFIG_ARCH_VIRT=y
CONFIG_OF=y                     # device tree (QEMU passes the virt DTB)
CONFIG_ARM_GIC_V3=y             # the virt interrupt controller
CONFIG_ARM_ARCH_TIMER=y         # the generic timer
CONFIG_SYSFS=y                  # devtmpfs / driver model

## --- explicitly OFF: AIOS needs none of these; drop them for a thin substrate ---
# (these are the big-ticket items a default config carries that the appliance does not use)
CONFIG_NET=n                    # AIOS has its own model; the appliance does no host networking
CONFIG_BLOCK=n                  # initramfs-only; no block devices
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_USB_SUPPORT=n
CONFIG_WIRELESS=n
CONFIG_MODULES=n                # a single static image
