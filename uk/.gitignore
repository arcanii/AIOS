# Build artifacts (aarch64 Linux ELFs, produced by run.sh in the container).
# Anchored to uk/ root so the guest/*.c sources are never matched.
/aios-uk
/guest_*
/prog_*
/sbase-*
/dash
*.o
/.pal.stamp

# AIOS root filesystem image (built by mkaiosroot.sh)
/aiosroot/
/aiosroot.tar

# Appliance build outputs (build_appliance.sh): static binaries, initramfs, kernel Image, kernel source
/appliance/build/
/appliance/out/
