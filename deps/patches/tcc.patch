 	if (addend & 0xffful)
diff --git a/arm64-link.c b/arm64-link.c
index cfdd95ea..85e18fb7 100644
--- a/arm64-link.c
+++ b/arm64-link.c
@@ -45,6 +45,9 @@ ST_FUNC int code_reloc (int reloc_type)
         case R_AARCH64_LDST8_ABS_LO12_NC:
         case R_AARCH64_GLOB_DAT:
         case R_AARCH64_COPY:
+        case R_AARCH64_PREL64:
+        case R_AARCH64_TLSLE_ADD_TPREL_HI12:
+        case R_AARCH64_TLSLE_ADD_TPREL_LO12_NC:
             return 0;
 
         case R_AARCH64_JUMP26:
@@ -76,6 +79,9 @@ ST_FUNC int gotplt_entry_type (int reloc_type)
         case R_AARCH64_GLOB_DAT:
         case R_AARCH64_JUMP_SLOT:
         case R_AARCH64_COPY:
+        case R_AARCH64_PREL64:
+        case R_AARCH64_TLSLE_ADD_TPREL_HI12:
+        case R_AARCH64_TLSLE_ADD_TPREL_LO12_NC:
             return NO_GOTPLT_ENTRY;
 
         case R_AARCH64_ABS32:
@@ -312,6 +318,33 @@ ST_FUNC void relocate(TCCState *s1, ElfW_Rel *rel, int type, unsigned char *ptr,
 #endif
             /* do nothing */
             return;
+        case R_AARCH64_PREL64:
+            add64le(ptr, val - addr);
+            return;
+        case R_AARCH64_TLSLE_ADD_TPREL_HI12:
+        case R_AARCH64_TLSLE_ADD_TPREL_LO12_NC:
+        {
+            /* AArch64 variant 1 TLS: TP + TCB(16) + offset from TLS start.
+             * Must use FIRST TLS section addr as base, not per-symbol
+             * section addr, so .tbss offsets include .tdata size. */
+            addr_t tls_start = 0;
+            int ti;
+            for (ti = 1; ti < s1->nb_sections; ti++) {
+                Section *ts = s1->sections[ti];
+                if (ts && (ts->sh_flags & SHF_TLS)) {
+                    tls_start = ts->sh_addr;
+                    break;
+                }
+            }
+            uint64_t tp_off = 16 + (val - tls_start);
+            if (type == R_AARCH64_TLSLE_ADD_TPREL_HI12)
+                write32le(ptr, (read32le(ptr) & 0xffc003ff) |
+                               (((tp_off >> 12) & 0xfff) << 10));
+            else
+                write32le(ptr, (read32le(ptr) & 0xffc003ff) |
+                               ((tp_off & 0xfff) << 10));
+            return;
+        }
         default:
             fprintf(stderr, "FIXME: handle reloc type %x at %x [%p] to %x\n",
                     type, (unsigned)addr, ptr, (unsigned)val);
