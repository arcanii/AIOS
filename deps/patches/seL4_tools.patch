diff --git a/elfloader-tool/src/drivers/uart/bcm-uart.c b/elfloader-tool/src/drivers/uart/bcm-uart.c
index 8fcf3d1..a98333e 100644
--- a/elfloader-tool/src/drivers/uart/bcm-uart.c
+++ b/elfloader-tool/src/drivers/uart/bcm-uart.c
@@ -40,17 +40,30 @@ static int bcm2835_uart_putchar(struct elfloader_device *dev, unsigned int c)
 {
     volatile void *mmio = dev->region_bases[0];
 
-    /* Wait until UART ready for the next character. */
-    while (!(*UART_REG(mmio, MU_LSR) & MU_LSR_TXIDLE));
-
-    /* Put in the register to be sent*/
-    *UART_REG(mmio, MU_IO) = (c & 0xff);
+    /* Wait until the transmitter is idle, with a bounded timeout so a
+     * not-clocked Mini UART degrades to a no-op instead of hanging the
+     * elfloader. The firmware leaves this UART clocked at 115200 for
+     * uart_2ndstage (no disable-bt), so TXIDLE clears well within the
+     * bound -- v0.4.178 (RPi4 SMP debug prints the secondary-core
+     * bring-up trace through here). */
+    for (int t = 0; t < 100000; t++) {
+        if (*UART_REG(mmio, MU_LSR) & MU_LSR_TXIDLE) {
+            *UART_REG(mmio, MU_IO) = (c & 0xff);
+            return 0;
+        }
+    }
 
     return 0;
 }
 
 static int bcm2835_uart_init(struct elfloader_device *dev, UNUSED void *match_data)
 {
+    /* Register as the elfloader console. The Mini UART is the DTB stdout-path
+     * (serial1) and the firmware leaves it clocked at 115200 for uart_2ndstage,
+     * so the elfloader can print on it directly; the bounded putchar above
+     * keeps a not-clocked UART from hanging the boot. (v0.4.178 briefly skipped
+     * registration -- printf no-op'd via the NULL plat_console_putchar check --
+     * which is why the SMP bring-up trace was invisible.) */
     uart_set_out(dev);
     return 0;
 }
diff --git a/elfloader-tool/src/drivers/uart/pl011-uart.c b/elfloader-tool/src/drivers/uart/pl011-uart.c
index bcd5cd5..2041d60 100644
--- a/elfloader-tool/src/drivers/uart/pl011-uart.c
+++ b/elfloader-tool/src/drivers/uart/pl011-uart.c
@@ -20,12 +20,15 @@ int pl011_uart_putchar(struct elfloader_device *dev, unsigned int c)
 {
     volatile void *mmio = dev->region_bases[0];
 
-    /* Wait until UART ready for the next character. */
-    while ((*UART_REG(mmio, UARTFR) & UARTFR_TXFF) != 0);
-
-    /* Add character to the buffer. */
-    *UART_REG(mmio, UARTDR) = (c & 0xff);
-
+    /* Wait until UART ready, with a bounded timeout so a not-yet-clocked PL011
+     * (e.g. if the firmware did not set it up) degrades to a no-op instead of
+     * hanging the elfloader -- v0.4.178 (RPi4 SMP debug enables this path). */
+    for (int t = 0; t < 100000; t++) {
+        if ((*UART_REG(mmio, UARTFR) & UARTFR_TXFF) == 0) {
+            *UART_REG(mmio, UARTDR) = (c & 0xff);
+            return 0;
+        }
+    }
     return 0;
 }
 
