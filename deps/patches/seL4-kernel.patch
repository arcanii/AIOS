+#ifdef AIOS_TLBI_BROADCAST
+    /* AIOS stall-hunt candidate C (idle-teardown TLBI/DVM freeze): use the
+     * inner-shareable BROADCAST tlbi (what Linux SMP does) instead of the
+     * local-only `tlbi vae1`. The Pi4 probe proved DVM/CMO broadcast is
