diff --git a/src/arch/arm/machine/errata.c b/src/arch/arm/machine/errata.c
index f8dac15c3..ecf11b2fa 100644
--- a/src/arch/arm/machine/errata.c
+++ b/src/arch/arm/machine/errata.c
@@ -8,11 +8,342 @@
 #include <api/types.h>
 #include <arch/machine.h>
 #include <arch/machine/hardware.h>
+#include <machine/io.h>
 #include <util.h>
+#include <model/statedata.h>   /* CURRENT_CPU_INDEX for the per-core TLBI profiler */
 
 /* Prototyped here as this is referenced from assembly */
 void arm_errata(void);
 
+/* ======================================================================
+ * AIOS A72 IMP-DEF register probe (DIAGNOSTIC -- remove after the stall hunt).
+ *
+ * Reads CPUECTLR_EL1 / CPUACTLR_EL1 / L2CTLR_EL1 / L2ACTLR_EL1 on the boot
+ * core and prints them + the bits relevant to the idle-teardown TLBI/DVM
+ * stall (SMPEN, dynamic-retention, the L2ACTLR DVM-broadcast controls, the
+ * CPUACTLR force-clock / treat-DSB-as-SY bits).  The RPi armstub writes
+ * ACTLR_EL3 to UN-trap EL1 access to these IMP-DEF regs, so the reads should
+ * succeed -- but to be robust against an old armstub (or a QEMU model that
+ * does not implement them) every read runs under a temporary EL1 vector
+ * table whose synchronous handler skips a trapping MRS and records it, so a
+ * trap is reported instead of halting the kernel.
+ * ====================================================================== */
+volatile word_t aios_probe_trapped;
+
+asm(
+    "   .pushsection .text, \"ax\"                  \n"
+    "   .balign 0x800                               \n"
+    "   .globl aios_probe_vtable                    \n"
+    "aios_probe_vtable:                             \n"
+    "   .rept 16                                    \n"
+    "   .balign 0x80                                \n"
+    "   b   aios_probe_trap                         \n"
+    "   .endr                                       \n"
+    "aios_probe_trap:                               \n"
+    "   adrp x9, aios_probe_trapped                 \n"
+    "   mov  w10, #1                                \n"
+    "   str  x10, [x9, #:lo12:aios_probe_trapped]   \n"
+    "   mrs  x9, elr_el1                            \n"
+    "   add  x9, x9, #4                             \n"
+    "   msr  elr_el1, x9                            \n"
+    "   eret                                        \n"
+    "   .globl aios_probe_rd_cpuectlr               \n"
+    "aios_probe_rd_cpuectlr:                        \n"
+    "   mrs  x0, S3_1_C15_C2_1                      \n"
+    "   ret                                         \n"
+    "   .globl aios_probe_rd_cpuactlr               \n"
+    "aios_probe_rd_cpuactlr:                        \n"
+    "   mrs  x0, S3_1_C15_C2_0                      \n"
+    "   ret                                         \n"
+    "   .globl aios_probe_rd_l2ctlr                 \n"
+    "aios_probe_rd_l2ctlr:                          \n"
+    "   mrs  x0, S3_1_C11_C0_2                      \n"
+    "   ret                                         \n"
+    "   .globl aios_probe_rd_l2actlr                \n"
+    "aios_probe_rd_l2actlr:                         \n"
+    "   mrs  x0, S3_1_C15_C0_0                      \n"
+    "   ret                                         \n"
+    "   .popsection                                 \n"
+);
+
+extern word_t aios_probe_rd_cpuectlr(void);
+extern word_t aios_probe_rd_cpuactlr(void);
+extern word_t aios_probe_rd_l2ctlr(void);
+extern word_t aios_probe_rd_l2actlr(void);
+extern char aios_probe_vtable[];
+
+static word_t aios_probe_one(word_t (*rd)(void), int *trapped)
+{
+    aios_probe_trapped = 0;
+    asm volatile("isb");
+    word_t v = rd();
+    asm volatile("isb");
+    *trapped = (int)aios_probe_trapped;
+    return v;
+}
+
+/* AIOS PMU init (diagnostic): program 5 A72 event counters so the TLBI-stall profiler
+ * can dump what core 0 actually did across the ~32.4s freeze. EL1 PMU access is live (no
+ * EL2 -> no MDCR_EL2.TPM trap; seL4 already enables PMCR.E for cpuacct). We only ADD the
+ * event counters; PMCCNTR is left untouched (the profiler uses CNTPCT for wall-clock).
+ * Counters are 32-bit and may wrap on a 32s stall, but the qualitative read survives:
+ * INST_RETIRED~=0 => wedged on ONE instruction (the dsb), and BUS_ACCESS ~=0 (clean wait
+ * on a parked fabric) vs large (a retry storm) discriminates the mechanism. Called per-core
+ * from the A72 boot probes; A72-guarded so QEMU a53 leaves the counters off (prints 0s). */
+BOOT_CODE static void aios_pmu_init(void)
+{
+    word_t midr = getProcessorID();
+    if (((midr >> 4) & 0xFFF) != 0xD08) {
+        return;
+    }
+    word_t pmcr;
+    asm volatile("mrs %0, S3_3_C9_C12_0" : "=r"(pmcr));           /* PMCR_EL0 */
+    asm volatile("msr S3_3_C9_C12_0, %0" :: "r"(pmcr | 1u));      /* E: master enable (idempotent) */
+    asm volatile("msr S3_3_C14_C12_0, %0" :: "r"((word_t)0x08)); /* PMEVTYPER0 = INST_RETIRED */
+    asm volatile("msr S3_3_C14_C12_1, %0" :: "r"((word_t)0x19)); /* PMEVTYPER1 = BUS_ACCESS */
+    asm volatile("msr S3_3_C14_C12_2, %0" :: "r"((word_t)0x13)); /* PMEVTYPER2 = MEM_ACCESS */
+    asm volatile("msr S3_3_C14_C12_3, %0" :: "r"((word_t)0x17)); /* PMEVTYPER3 = L2D_CACHE_REFILL */
+    asm volatile("msr S3_3_C14_C12_4, %0" :: "r"((word_t)0x11)); /* PMEVTYPER4 = CPU_CYCLES */
+    asm volatile("msr S3_3_C9_C12_1, %0" :: "r"((word_t)0x1f));  /* PMCNTENSET_EL0: enable cnt 0..4 */
+    asm volatile("isb");
+}
+
+void aios_a72_probe(void);
+BOOT_CODE void aios_a72_probe(void)
+{
+    word_t old_vbar;
+    int t_ectlr, t_actlr, t_l2c, t_l2a;
+    word_t midr = getProcessorID();
+
+    /* Only meaningful on the Cortex-A72 (part 0xD08); these IMP-DEF encodings
+     * differ on other cores. Skip elsewhere so the probe is safe everywhere. */
+    if (((midr >> 4) & 0xFFF) != 0xD08) {
+        printf("[A72PROBE] MIDR=%"SEL4_PRIx_word" (not A72, skipping)\n", midr);
+        return;
+    }
+
+    asm volatile("mrs %0, vbar_el1" : "=r"(old_vbar));
+    asm volatile("msr vbar_el1, %0" :: "r"((word_t)aios_probe_vtable));
+    asm volatile("isb");
+
+    word_t ectlr = aios_probe_one(aios_probe_rd_cpuectlr, &t_ectlr);
+    word_t actlr = aios_probe_one(aios_probe_rd_cpuactlr, &t_actlr);
+    word_t l2c   = aios_probe_one(aios_probe_rd_l2ctlr,   &t_l2c);
+    word_t l2a   = aios_probe_one(aios_probe_rd_l2actlr,  &t_l2a);
+
+    asm volatile("msr vbar_el1, %0" :: "r"(old_vbar));
+    asm volatile("isb");
+
+    printf("[A72PROBE] MIDR=%"SEL4_PRIx_word"\n", midr);
+    if (t_ectlr) {
+        printf("[A72PROBE] CPUECTLR_EL1=TRAPPED\n");
+    } else {
+        printf("[A72PROBE] CPUECTLR_EL1=%"SEL4_PRIx_word" SMPEN=%d RET=%d\n",
+               ectlr, (int)((ectlr >> 6) & 1), (int)(ectlr & 7));
+    }
+    if (t_actlr) {
+        printf("[A72PROBE] CPUACTLR_EL1=TRAPPED\n");
+    } else {
+        printf("[A72PROBE] CPUACTLR_EL1=%"SEL4_PRIx_word" FORCECLK30=%d DSBSY53=%d\n",
+               actlr, (int)((actlr >> 30) & 1), (int)((actlr >> 53) & 1));
+    }
+    if (t_l2c) {
+        printf("[A72PROBE] L2CTLR_EL1=TRAPPED\n");
+    } else {
+        printf("[A72PROBE] L2CTLR_EL1=%"SEL4_PRIx_word"\n", l2c);
+    }
+    if (t_l2a) {
+        printf("[A72PROBE] L2ACTLR_EL1=TRAPPED\n");
+    } else {
+        printf("[A72PROBE] L2ACTLR_EL1=%"SEL4_PRIx_word" DVMDIS8=%d DSBNODVM11=%d\n",
+               l2a, (int)((l2a >> 8) & 1), (int)((l2a >> 11) & 1));
+    }
+    printf("[A72PROBE] done\n");
+    aios_pmu_init();   /* arm the stall-profiler PMU counters on the boot core */
+}
+
+/* ----------------------------------------------------------------------
+ * SECONDARY-core CPUECTLR.SMPEN probe (DIAGNOSTIC -- remove after the stall
+ * hunt).  The boot probe above runs only on the boot core; this runs once on
+ * each secondary.  Called from try_init_kernel_secondary_core() AFTER the
+ * secondary has taken the big kernel lock (NODE_LOCK_SYS), so it executes
+ * serialized: the shared trap flag (aios_probe_trapped) and the UART are
+ * race-free, and the primary is spinning silently in release_secondary_cpus()
+ * for this whole window.  Goal: confirm SMPEN=1 on cores 1-3.  A secondary with
+ * SMPEN=0 would not join the inner-shareable DVM domain, so core 0's tlbi
+ * completion could hang on it to the BCM2711 fabric timeout -- the leading
+ * remaining suspect for the idle-teardown stall.  Reuses the fault-survivable
+ * read path (temporary EL1 vector table) so a trapping MRS reports TRAPPED
+ * instead of halting the secondary.
+ * ---------------------------------------------------------------------- */
+void aios_a72_probe_secondary(word_t core);
+BOOT_CODE void aios_a72_probe_secondary(word_t core)
+{
+    word_t midr = getProcessorID();
+
+    /* CPUECTLR_EL1 is an A72 (part 0xD08) IMP-DEF encoding; skip elsewhere. */
+    if (((midr >> 4) & 0xFFF) != 0xD08) {
+        printf("[A72PROBE] core=%d MIDR=%"SEL4_PRIx_word" (not A72)\n",
+               (int)core, midr);
+        return;
+    }
+
+    word_t old_vbar;
+    int trapped;
+    asm volatile("mrs %0, vbar_el1" : "=r"(old_vbar));
+    asm volatile("msr vbar_el1, %0" :: "r"((word_t)aios_probe_vtable));
+    asm volatile("isb");
+
+    word_t ectlr = aios_probe_one(aios_probe_rd_cpuectlr, &trapped);
+
+    asm volatile("msr vbar_el1, %0" :: "r"(old_vbar));
+    asm volatile("isb");
+
+    if (trapped) {
+        printf("[A72PROBE] core=%d CPUECTLR_EL1=TRAPPED\n", (int)core);
+    } else {
+        printf("[A72PROBE] core=%d CPUECTLR_EL1=%"SEL4_PRIx_word" SMPEN=%d RET=%d\n",
+               (int)core, ectlr, (int)((ectlr >> 6) & 1), (int)(ectlr & 7));
+    }
+    aios_pmu_init();   /* arm the stall-profiler PMU counters on this secondary core */
+}
+
+/* ----------------------------------------------------------------------
+ * exec-teardown TLBI-stall PROFILER (DIAGNOSTIC). The ~33s idle-teardown freeze
+ * is the unmap `tlbi vae1`+`dsb` (DVM-Sync) hanging when the BCM2711 SCB fabric
+ * has quiesced after idle. invalidateLocalTLB_VAASID (machine.h) times each
+ * tlbi+dsb and calls aios_tlbi_profile(). On a slow (>=1s) tlbi it dumps rich
+ * context to hunt a COMMON CAUSE:
+ *   core   = the stalling core.
+ *   dur    = the tlbi+dsb duration (the stall itself).
+ *   gap    = THIS core's idle-gap (ms since this core's PREVIOUS tlbi; per-core,
+ *            so it is clean -- the old single global was SMP-contaminated). Large
+ *            gap => first-tlbi-after-idle (HW fabric quiescence); small gap =>
+ *            mid-burst (would implicate a software/contention cause we can fix).
+ *   asid/va= which ASID (process) + page VA is being invalidated -- to see if
+ *            every stall is the same operation (e.g. always the dying proc).
+ *   qgap   = ms since EACH core's last tlbi = a cross-core quiescence snapshot
+ *            (are all cores dead, or is one active?). The stalling core reads 0.
+ *   ipi    = cumulative count of teardown tlbis that ACTUALLY IPI'd a remote core
+ *            (bumped in tlb.h). Tests the residency/ipi_wait theory; under core-0
+ *            pinning expect 0 => the stall is the LOCAL dsb, not the IPI barrier.
+ *   cnt    = per-core total profiled-tlbi counts.
+ * ---------------------------------------------------------------------- */
+#define AIOS_TLBISTALL_MS 1000ull
+#define AIOS_TLBI_NCORES 4
+volatile word_t aios_last_tlbi_t[AIOS_TLBI_NCORES];
+volatile word_t aios_tlbi_cnt[AIOS_TLBI_NCORES];
+volatile word_t aios_burst_start_t[AIOS_TLBI_NCORES];  /* per-core teardown-burst start tick */
+volatile word_t aios_burst_cnt[AIOS_TLBI_NCORES];      /* tlbi position within the current burst */
+volatile word_t aios_tlbistall_count;
+volatile word_t aios_tlbi_ipi_sent;   /* bumped in tlb.h on a real remote-IPI tlbi */
+volatile word_t aios_last_unmap_paddr; /* phys addr of last unmapped page (vspace.c unmapPage) */
+volatile word_t aios_last_unmap_pte;   /* raw PTE of last unmapped page */
+/* per-physical-band tlbi + stall counts. The gpu_mem/VideoCore band is the top
+ * 64MB of DRAM [0xf8000000, 0xfc000000). If lbS (low-band stalls) stays 0 while
+ * hbS climbs, the stall is EXCLUSIVELY the GPU-reserved band -> root cause locked. */
+#define AIOS_GPUBAND_LO 0xf8000000ull
+#define AIOS_GPUBAND_HI 0xfc000000ull
+volatile word_t aios_lowband_tlbi, aios_highband_tlbi;
+volatile word_t aios_lowband_stall, aios_highband_stall;
+/* AIOS per-core liveness heartbeat: idle.S stamps CNTPCT into this core's padded
+ * (64-byte, no false-share) slot every idle iteration. On a teardown stall the issuing
+ * core (in the kernel, not idling) shows a large lag; a SIBLING showing ~0 lag proves it
+ * kept running through the stall (core-LOCAL -> multi-core survives), while ~stall-duration
+ * means it froze too (cluster-WIDE). The decisive un-pinning-feasibility test. */
+volatile word_t aios_core_heartbeat[AIOS_TLBI_NCORES * 8];
+
+#ifdef ENABLE_SMP_SUPPORT
+/* AIOS session-4 residency-fix signature (definitions in arm/64 vspace.c). File-scope
+ * externs so the profiler print below can show res= (raw residency) vs rmask= (the masked
+ * cores a teardown may IPI) without a nested-extern warning. */
+extern word_t aios_resident_cores_mask;
+word_t aios_asid_residency_raw(word_t asid);
+#endif
+
+void aios_tlbi_profile(word_t t0, word_t t1, word_t mva_plus_asid, const word_t *pm0, const word_t *pm1);
+void aios_tlbi_profile(word_t t0, word_t t1, word_t mva_plus_asid, const word_t *pm0, const word_t *pm1)
+{
+    word_t freq;
+    asm volatile("mrs %0, cntfrq_el0" : "=r"(freq));
+    if (!freq) {
+        freq = 54000000;
+    }
+    word_t core = CURRENT_CPU_INDEX();
+    if (core >= AIOS_TLBI_NCORES) {
+        core = 0;
+    }
+    word_t gap_ticks = t0 - aios_last_tlbi_t[core];
+    aios_last_tlbi_t[core] = t1;
+    aios_tlbi_cnt[core]++;
+    /* per-core BURST tracking: a gap > 100ms ends a burst (a real idle between
+     * teardowns; within a burst gaps are <1ms). bpos/bms then show WHERE in the
+     * teardown burst the stall hangs -- always the Nth tlbi, or Mms in? */
+    if (gap_ticks > freq / 10) {
+        aios_burst_start_t[core] = t0;
+        aios_burst_cnt[core] = 0;
+    } else {
+        aios_burst_cnt[core]++;
+    }
+    int hb = (aios_last_unmap_paddr >= AIOS_GPUBAND_LO
+              && aios_last_unmap_paddr < AIOS_GPUBAND_HI);
+    if (hb) { aios_highband_tlbi++; } else { aios_lowband_tlbi++; }
+    word_t dur_ms = (t1 - t0) * 1000ull / freq;
+    if (dur_ms >= AIOS_TLBISTALL_MS) {
+        aios_tlbistall_count++;
+        if (hb) { aios_highband_stall++; } else { aios_lowband_stall++; }
+        word_t gap_ms = gap_ticks * 1000ull / freq;
+        word_t burst_ms = (t1 - aios_burst_start_t[core]) * 1000ull / freq;
+        word_t asid = mva_plus_asid >> 48;
+        word_t va = (mva_plus_asid & 0xFFFFFFFFFFFFull) << 12;
+        /* AIOS session-4 residency-fix signature: res = the RAW per-ASID core-residency
+         * bitmap; rmask = the cores a shootdown may IPI (the fix's mask, default 0x1). On
+         * the stalling asid=1 these read res=0xf rmask=0x1 -> the teardown stays core-LOCAL
+         * (no IPI to the idle siblings), so ipi STOPS climbing and hb_ms[1,2,3]~=0. The
+         * extern decls are at file scope (above) to avoid a nested-extern warning. */
+#ifdef ENABLE_SMP_SUPPORT
+        unsigned res = (unsigned)aios_asid_residency_raw(asid);
+        unsigned rmask = (unsigned)aios_resident_cores_mask;
+#else
+        unsigned res = 0, rmask = 1;
+#endif
+        int qg[AIOS_TLBI_NCORES];
+        for (int c = 0; c < AIOS_TLBI_NCORES; c++) {
+            qg[c] = (int)((t1 - aios_last_tlbi_t[c]) * 1000ull / freq);
+        }
+        /* PMU deltas across the tlbi+dsb (what the wedged core did): inst~=0 + cyc large
+         * => clocked but stuck on ONE instruction (the dsb); bus~=0 => a clean wait on a
+         * PARKED fabric, vs large => a retry storm (a different bug). 32-bit counters masked
+         * to their mod-2^32 delta -- a large value may have wrapped, but ~0-vs-large holds. */
+        int d_inst = (int)((pm1[0] - pm0[0]) & 0xffffffffu);
+        int d_bus  = (int)((pm1[1] - pm0[1]) & 0xffffffffu);
+        int d_mem  = (int)((pm1[2] - pm0[2]) & 0xffffffffu);
+        int d_l2   = (int)((pm1[3] - pm0[3]) & 0xffffffffu);
+        int d_cyc  = (int)((pm1[4] - pm0[4]) & 0xffffffffu);
+        /* per-core heartbeat lag (ms since each core last stamped idle.S); a SIBLING ~=0 =
+         * alive through the stall (core-LOCAL), ~=dur = froze too; -1 = never idled. */
+        int hbl[AIOS_TLBI_NCORES];
+        for (int c = 0; c < AIOS_TLBI_NCORES; c++) {
+            word_t h = aios_core_heartbeat[c * 8];
+            hbl[c] = h ? (int)((t1 - h) * 1000ull / freq) : -1;
+        }
+        printf("[TLBISTALL] core=%d dur=%dms gap=%dms bpos=%d bms=%d asid=%d res=0x%x rmask=0x%x va=0x%"SEL4_PRIx_word
+               " pa=0x%"SEL4_PRIx_word" pte=0x%"SEL4_PRIx_word
+               " n=%d ipi=%d band=%d hbS=%d lbS=%d hbT=%d lbT=%d"
+               " qgap_ms=[%d,%d,%d,%d]"
+               " pmu=[inst=%d bus=%d mem=%d l2=%d cyc=%d] hb_ms=[%d,%d,%d,%d]\n",
+               (int)core, (int)dur_ms, (int)gap_ms,
+               (int)aios_burst_cnt[core], (int)burst_ms, (int)asid, res, rmask, va,
+               aios_last_unmap_paddr, aios_last_unmap_pte,
+               (int)aios_tlbistall_count, (int)aios_tlbi_ipi_sent,
+               hb, (int)aios_highband_stall, (int)aios_lowband_stall,
+               (int)aios_highband_tlbi, (int)aios_lowband_tlbi,
+               qg[0], qg[1], qg[2], qg[3],
+               d_inst, d_bus, d_mem, d_l2, d_cyc,
+               hbl[0], hbl[1], hbl[2], hbl[3]);
+    }
+}
