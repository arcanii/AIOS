 {
     c_exit_hook();
+    aios_checkpoint(11);
+    aios_breadcrumb(11, (word_t)NODE_STATE(ksCurThread)->tcbArch.tcbContext.registers,
+                    NODE_STATE(ksCurThread)->tcbArch.tcbContext.registers[NextIP]);
