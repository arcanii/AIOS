+{
+    word_t midr = getProcessorID();
+    if (((midr >> 4) & 0xFFF) != 0xD08) {
+        return;
+    }
+    word_t pmcr;
+    asm volatile("mrs %0, S3_3_C9_C12_0" : "=r"(pmcr));           /* PMCR_EL0 */
+    asm volatile("msr S3_3_C9_C12_0, %0" :: "r"(pmcr | 1u));      /* E: master enable (idempotent) */
+    asm volatile("msr S3_3_C14_C12_0, %0" :: "r"((word_t)0x08)); /* PMEVTYPER0 = INST_RETIRED */
+    asm volatile("msr S3_3_C14_C12_1, %0" :: "r"((word_t)0x19)); /* PMEVTYPER1 = BUS_ACCESS */
+    asm volatile("msr S3_3_C14_C12_2, %0" :: "r"((word_t)0x13)); /* PMEVTYPER2 = MEM_ACCESS */
+    asm volatile("msr S3_3_C14_C12_3, %0" :: "r"((word_t)0x17)); /* PMEVTYPER3 = L2D_CACHE_REFILL */
+    asm volatile("msr S3_3_C14_C12_4, %0" :: "r"((word_t)0x11)); /* PMEVTYPER4 = CPU_CYCLES */
+    asm volatile("msr S3_3_C14_C12_5, %0" :: "r"((word_t)0x01)); /* PMEVTYPER5 = L1I_CACHE_REFILL (session-10: I-side fetch) */
+    asm volatile("msr S3_3_C9_C12_1, %0" :: "r"((word_t)0x3f));  /* PMCNTENSET_EL0: enable cnt 0..5 */
+    asm volatile("isb");
