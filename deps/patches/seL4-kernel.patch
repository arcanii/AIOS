+ * (no macro guard) to avoid any include/-Wundef issue; helper defined in errata.c. */
+extern void aios_checkpoint(word_t stage);
+/* AIOS session-10 (re-localize): record the regs base + user PC (NextIP) about to be used by the
+ * eret below, so a wedge in this exit's ldp/eret/user-fetch path prints its candidate address at
+ * the next kernel entry. See aios_breadcrumb in errata.c. */
+extern void aios_breadcrumb(word_t site, word_t regs, word_t pc);
+
