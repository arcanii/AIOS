+#if AIOS_ASID_GEN
+/* ===================== ASID-generation hw-asid recycler =====================
+ * See arch/machine/tlb.h for the rationale + invariant, and the design doc
+ * docs/NEXT_20260621_asid_generation_IMPL.md. The seL4 logical asid stays the cap
+ * identity everywhere (asid_map, findVSpaceForASID, residency); ONLY TTBR0[63:48]
+ * carries the HARDWARE asid resolved here. */
+#define AIOS_HWASID_NASIDS 2048            /* same low-asid bound as residency/lazy-TLB */
+#ifndef AIOS_HWASID_MAX
+#define AIOS_HWASID_MAX 0xFFFFu            /* TCR_EL1.AS=1 (elfloader TCR_ASID16); boot [ASIDGEN] probe confirms */
+#endif
+/* 32-bit generation so it never RECYCLES within a boot: a recycled gen value could let a stale
+ * armKSHwAsid[].gen masquerade as live and alias a hw asid (review M2). At 2^32 gens x 2^16
+ * assigns/gen that is ~2^48 assignments -- unreachable. */
+typedef struct { uint16_t hw_asid; uint32_t gen; } aios_hwasid_ent_t;
+static aios_hwasid_ent_t armKSHwAsid[AIOS_HWASID_NASIDS];   /* sel4 asid -> (hw asid, gen) */
+static uint32_t g_hwasid_gen  = 1;         /* current generation (0 = "never bound" sentinel) */
+static uint32_t g_hwasid_next = 1;         /* next free hw asid this gen (0 reserved = none) */
+/* validity-signature counters (serial [ASIDGEN] print + a future /proc/asidgen): prove the
+ * recycler is ACTIVE + climbing during the HW stall A/B, not merely compiled in. */
+word_t aios_hwasid_assigns = 0;
+word_t aios_hwasid_gen_now = 1;
+word_t aios_hwasid_wraps   = 0;
+
+/* AIOS coresched safety S1 (Linux PCID reserved-asid; host-test-proven in asidgen_host_test.c).
+ * armKSActiveSel4Asid[c] = the sel4 asid core c is currently running (its TTBR0 hw asid =
+ * armKSHwAsid[that].hw_asid), recorded at the end of aios_hwasid_for. At a generation WRAP, every
+ * still-running vspace's hw asid is RESERVED for the whole new generation (and its entry re-stamped
+ * into the new gen with the SAME hw), so a peer core that keeps running across the wrap never has
+ * its hw asid handed to a DIFFERENT vspace (which would be a silent cross-process stale TLB hit).
+ * g_hwasid_reserved[] is the fixed reserved set captured AT the wrap (<= one per core); the handout
+ * loop skips those values for the rest of the generation -- NOT just while the asid stays active,
+ * because the carried asid owns that hw value until the next wrap flush. Dormant under the default
+ * all-threads-on-core-0 config (only one asid is ever active), but REQUIRED before a user vspace
+ * runs on a secondary core (coresched / unpinning core 0). */
+static word_t armKSActiveSel4Asid[CONFIG_MAX_NUM_NODES];
+static uint16_t g_hwasid_reserved[CONFIG_MAX_NUM_NODES];
+static word_t g_hwasid_nreserved;
+
+static inline bool_t aios_hwasid_is_reserved(uint16_t v)
+{
+    for (word_t i = 0; i < g_hwasid_nreserved; i++) {
+        if (g_hwasid_reserved[i] == v) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* The asid currently loaded in TTBR0 on THIS core = the running thread's vspace asid (matches
+ * the self-detection in unmapPage). asidInvalid (0) when on the global/kernel vspace. */
+static inline asid_t aios_current_user_asid(void)
+{
+    cap_t root = TCB_PTR_CTE_PTR(NODE_STATE(ksCurThread), tcbVTable)->cap;
+    if (isValidNativeRoot(root)) {
+        return cap_vspace_cap_get_capVSMappedASID(root);
+    }
+    return asidInvalid;
+}
+
+/* Resolve (assign if needed) the HARDWARE asid for a seL4 logical asid. Called on the TTBR
+ * write path (setVMRoot / setVMRootForFlush / fastpath, via AIOS_HWASID). asid 0 (global
+ * vspace) and out-of-range asids are identity -- never generation-managed. */
+word_t aios_hwasid_for(word_t sel4_asid)
+{
+    if (unlikely(sel4_asid == 0 || sel4_asid >= AIOS_HWASID_NASIDS)) {
+        return sel4_asid;
+    }
+    word_t core = SMP_TERNARY(getCurrentCPUIndex(), 0);
+    aios_hwasid_ent_t *e = &armKSHwAsid[sel4_asid];
+    if (e->gen != g_hwasid_gen) {
+        if (unlikely(g_hwasid_next > AIOS_HWASID_MAX)) {
+            /* GENERATION WRAP: ONE full local flush (+ residency-masked remote). Rare, and it
+             * fires during ACTIVE context switching (warm fabric), NOT the after-idle cold path
+             * that hangs. S1 reserved-asid below carries every still-running vspace across the
+             * wrap so coresched peers stay coherent. */
+            uint32_t prev_gen = g_hwasid_gen;
+            g_hwasid_gen++;
+            if (g_hwasid_gen == 0) {
+                g_hwasid_gen = 1;   /* gen 0 is the "never bound" sentinel; never use it */
+            }
+            invalidateLocalTLB();
+#ifdef ENABLE_SMP_SUPPORT
+            doRemoteInvalidateTranslationAll(aios_resident_cores_mask);
+#endif
+            g_hwasid_next = 1;
+            aios_hwasid_wraps++;
+            aios_hwasid_gen_now = g_hwasid_gen;
+            /* S1: reserve + re-stamp every still-running vspace's hw asid into the new generation. */
+            g_hwasid_nreserved = 0;
+            for (word_t c = 0; c < CONFIG_MAX_NUM_NODES; c++) {
+                word_t a = armKSActiveSel4Asid[c];
+                if (a != 0 && a < AIOS_HWASID_NASIDS && armKSHwAsid[a].gen == prev_gen) {
+                    uint16_t h = armKSHwAsid[a].hw_asid;
+                    armKSHwAsid[a].gen = g_hwasid_gen;   /* carry into new gen, keep its hw asid */
+                    if (!aios_hwasid_is_reserved(h)) {
+                        g_hwasid_reserved[g_hwasid_nreserved++] = h;
+                    }
+                }
+            }
+        }
+        if (e->gen != g_hwasid_gen) {   /* may have been re-stamped by the reservation above */
+            while (g_hwasid_next <= AIOS_HWASID_MAX && aios_hwasid_is_reserved((uint16_t)g_hwasid_next)) {
+                g_hwasid_next++;   /* skip hw asids reserved for vspaces carried across the wrap */
+            }
+            e->hw_asid = (uint16_t)g_hwasid_next++;
+            e->gen     = g_hwasid_gen;
+            aios_hwasid_assigns++;
+#ifdef CONFIG_DEBUG_BUILD
+            /* on-HW tripwire (throttled): within a generation g_hwasid_next is monotonic and the
+             * reserved set is skipped, so two LIVE asids can never share a hw value unless the
+             * recycler regresses. Loud, non-fatal. */
+            if ((aios_hwasid_assigns & 0x3F) == 0) {
+                for (word_t a = 1; a < AIOS_HWASID_NASIDS; a++) {
+                    if (a != sel4_asid && armKSHwAsid[a].gen == g_hwasid_gen &&
+                        armKSHwAsid[a].hw_asid == e->hw_asid) {
+                        printf("[ASIDGEN-BUG] hw=0x%x shared by sel4 asids 0x%x and 0x%x\n",
+                               (unsigned)e->hw_asid, (unsigned)a, (unsigned)sel4_asid);
+                        break;
+                    }
+                }
+            }
+            if ((aios_hwasid_assigns & 0xFFF) == 0) {
+                printf("[ASIDGEN] assigns=0x%"SEL4_PRIx_word" gen=0x%"SEL4_PRIx_word
+                       " wraps=0x%"SEL4_PRIx_word"\n",
+                       aios_hwasid_assigns, (word_t)g_hwasid_gen, aios_hwasid_wraps);
+            }
+#endif
+        }
+    }
+    armKSActiveSel4Asid[core] = sel4_asid;   /* S1: this core now runs sel4_asid */
+    return e->hw_asid;
+}
+
+/* The hw asid currently bound to a sel4 asid THIS generation, or 0 = not bound (no live TLB
+ * entries tagged for it). Used by the S2 peer-resident flush path to target the right hw tag. */
+static inline word_t aios_hwasid_current(word_t sel4_asid)
+{
+    if (likely(sel4_asid != 0 && sel4_asid < AIOS_HWASID_NASIDS)) {
+        aios_hwasid_ent_t *e = &armKSHwAsid[sel4_asid];
+        return (e->gen == g_hwasid_gen) ? e->hw_asid : 0;
+    }
+    return sel4_asid;
+}
+
+/* Abandon a logical asid's hw binding: its (now stale) TLB entries are never consulted again
+ * under a live binding -- different asids get fresh hw values, and the abandoned value is wiped
+ * at the next gen wrap before it can be reissued. This is the replacement for a teardown/unmap
+ * `tlbi` (no DVM-Sync, no stall). The next aios_hwasid_for for this asid assigns a fresh hw.
+ *
+ * The abandon (no tlbi) is used ONLY for a self-only / single-core asid; the peer-resident case is
+ * handled by CORESCHED S2 in aios_asid_gen_invalidate (which keeps the binding + does a residency-
+ * masked remote tlbi instead of abandoning), so this clear is never reached while a peer still runs
+ * the asid. Dormant under core-0 pinning (residency always {core0}). */
+static inline void aios_hwasid_clear(word_t sel4_asid)
+{
+    if (likely(sel4_asid < AIOS_HWASID_NASIDS)) {
+        armKSHwAsid[sel4_asid].gen = 0;
+    }
+}
+#endif /* AIOS_ASID_GEN */
