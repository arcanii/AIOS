+        }
+        return;
+    }
+#endif
+    aios_hwasid_clear(asid);
+    if (asid != asidInvalid && asid == aios_current_user_asid()) {
+        setVMRoot(NODE_STATE(ksCurThread));   /* re-resolves via AIOS_HWASID -> fresh hw + isb */
+    }
+}
+#endif
