+extern word_t aios_probe_rd_cpuactlr(void);
+extern word_t aios_probe_rd_l2ctlr(void);
+extern word_t aios_probe_rd_l2actlr(void);
+extern char aios_probe_vtable[];
+
+static word_t aios_probe_one(word_t (*rd)(void), int *trapped)
+{
+    aios_probe_trapped = 0;
+    asm volatile("isb");
+    word_t v = rd();
+    asm volatile("isb");
+    *trapped = (int)aios_probe_trapped;
+    return v;
