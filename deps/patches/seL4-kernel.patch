diff --git a/include/arch/arm/arch/machine/tlb.h b/include/arch/arm/arch/machine/tlb.h
index 7235672db..0094b94a3 100644
--- a/include/arch/arm/arch/machine/tlb.h
+++ b/include/arch/arm/arch/machine/tlb.h
@@ -47,6 +47,39 @@ static inline void invalidateTranslationASID(hw_asid_t hw_asid)
     SMP_COND_STATEMENT(doRemoteInvalidateTranslationASID(hw_asid, MASK(CONFIG_MAX_NUM_NODES)));
 }
 
+/* AIOS v0.4.257: masked variants -- the remote shootdown IPIs only the given core mask
+ * instead of broadcasting to ALL cores. The per-ASID residency path (arm/64 vspace.c)
+ * passes the bitmap of cores that have actually run a vspace, so a teardown unmap no
+ * longer IPIs (and ipi_wait()-hangs on) quiesced idle cores -- the BCM2711 ~32s remote-
+ * TLBI stall (project_stall_hunt). doRemoteMaskOp already drops self + skips an empty
+ * mask, so under core-0 pinning (mask={core0}) no IPI is sent at all. */
+static inline void invalidateTranslationSingleMask(vptr_t vptr, word_t mask)
+{
+    invalidateTranslationSingleLocal(vptr);
+#ifdef ENABLE_SMP_SUPPORT
+    doRemoteInvalidateTranslationSingle(vptr, mask);
+#else
+    (void)mask;
+#endif
+}
+
+static inline void invalidateTranslationASIDMask(hw_asid_t hw_asid, word_t mask)
+{
+    invalidateTranslationASIDLocal(hw_asid);
+#ifdef ENABLE_SMP_SUPPORT
+    doRemoteInvalidateTranslationASID(hw_asid, mask);
+#else
+    (void)mask;
+#endif
+}
+
+#ifdef ENABLE_SMP_SUPPORT
+/* AIOS v0.4.257: mark per-ASID core residency (definition in arm/64 vspace.c). Prototype here
+ * so the fastpath vspace switch (switchToThread_fp), compiled before vspace.c in the unity
+ * build, can mark too -- required before any user thread runs off core 0. */
+void aios_mark_asid_residency(word_t asid);
+#endif
+
 static inline void invalidateTranslationAll(void)
 {
     invalidateTranslationAllLocal();
diff --git a/src/arch/arm/64/idle.S b/src/arch/arm/64/idle.S
