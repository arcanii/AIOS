+#ifdef ENABLE_SMP_SUPPORT
+/* AIOS v0.4.257 -- per-ASID core-residency bitmap for PRECISE TLB shootdown.
+ * Bit c set => core c has loaded this ASID into TTBR0 (so it MAY hold ASID-tagged TLB
+ * entries). A page/ASID teardown then IPIs only those cores instead of broadcasting to
+ * all CONFIG_MAX_NUM_NODES -- the BCM2711 remote-TLBI-to-idle-core ~32s stall hangs core 0
+ * in ipi_wait() on quiesced idle cores (project_stall_hunt). The bit is SET on context
+ * switch BEFORE the core can fill an entry, so the bitmap is always a SUPERSET of the
+ * cores that actually hold entries: shootdowns never miss a core (correct), they only skip
+ * cores that provably hold none. Updated under the big kernel lock (non-MCS) -> plain
+ * accesses, no atomics. Under core-0 pinning the bitmap is always {core0}, so doRemoteMaskOp
+ * (drops self, skips empty) sends NO IPI -> the stall vanishes. Bounded to the low ASIDs
+ * AIOS uses (pools 0..3 of the 16-bit space); an out-of-range ASID falls back to a full
+ * broadcast (still correct). Reset on deleteASID. uint8 holds up to 8 cores (we have 4). */
+#define AIOS_RESID_NASIDS 2048
+static uint8_t armKSASIDResidency[AIOS_RESID_NASIDS];
+/* NON-static + non-inline: the fastpath (switchToThread_fp) also marks residency, and its
+ * header is compiled BEFORE this file in the kernel unity build, so it calls through a
+ * prototype in arch/machine/tlb.h. Cheap (a bounds check + one OR), only on a vspace switch. */
+void aios_mark_asid_residency(word_t asid)
+{
+    if (likely(asid < AIOS_RESID_NASIDS)) {
+        word_t cpu = getCurrentCPUIndex();
+        armKSASIDResidency[asid] |= (uint8_t)BIT(cpu);
+        /* Widen the shootdown mask the first time GENUINE distributed work runs on a
+         * secondary core: a NON-root vspace (asid != IT_ASID) executing off core 0 ==
+         * coresched /proc/coresched.1 (user procs have their own asid >= 2). The keep-warm
+         * DIAGNOSTIC threads (fabwarm core 1, core_warm cores 1/2/3) also run on secondaries
+         * but in the ROOT vspace (asid == IT_ASID == 1), so they do NOT widen it -- which is
+         * exactly what keeps the default-config teardown of the immortal root asid
+         * core-LOCAL (the freeze the mask neutralizes). Sticky: once distributed work has
+         * run, full residency is honored thereafter so no recycled-asid stale TLB can slip
+         * past on a core the mask had been hiding. (Must be inside aios_mark, not the
+         * migrateTCB SetAffinity path -- the keep-warm threads SetAffinity to cores 1/2/3 at
+         * boot, which would mis-fire a migrate-based latch; only actually RUNNING a non-root
+         * vspace on a secondary is the true coresched signal.) */
+        if (cpu != 0 && asid != IT_ASID) {
+            aios_resident_cores_mask = MASK(CONFIG_MAX_NUM_NODES);
+        }
+    }
+}
+
+/* AIOS 2026-06-20 session-4 -- the cores a teardown TLB shootdown is allowed to IPI.
+ * Default BIT(0) (core 0 only). Rationale (project_stall_hunt session-3 PMU/heartbeat
+ * capture): EVERY ~32.4s teardown freeze is asid=1 (the immortal root-task vspace), and
+ * residency[1] = {0,1,2,3} because the keep-warm DIAGNOSTIC threads -- fabwarm (core 1)
+ * and core_warm (cores 1/2/3), both spawned in the ROOT vspace -- run their entry code
+ * once on cores 1-3 before parking, marking residency[1] for those cores; the bits never
+ * clear because asid 1 is never deleteASID'd. So every root self-munmap + the dying-proc
+ * aside1 IPI'd the idle siblings, and core 0's stalled dsb dragged them into THEIR own
+ * tlbi;dsb on the same parked BCM2711 SCB fabric -- the heartbeat proved cores 2,3 froze
+ * for the full stall (hb_ms[2,3] == dur). Under the default all-threads-pinned-to-core-0
+ * model those siblings only ever run the idle thread (global kernel vspace) or a PARKED
+ * keep-warm, so they hold no LIVE user translation they will consult again -- masking
+ * their residency bit out makes a teardown stay core-LOCAL (no remote IPI), so the freeze
+ * no longer spreads cluster-wide and a watchdog core can survive it. Latched WIDE (sticky)
+ * by aios_mark_asid_residency the first time a NON-root vspace runs on a secondary core
+ * (genuine coresched distribution), so distributed user work stays shootdown-correct. NOTE
+ * the keep-warm threads DO SetAffinity to cores 1/2/3 at boot, so a migrateTCB-based latch
+ * would mis-fire -- the widen lives in aios_mark instead, keyed on a non-root asid. */
+word_t aios_resident_cores_mask = 1; /* BIT(0) */
+/* Raw (un-masked) residency bitmap of an asid -- for the TLBI-stall profiler diagnostic
+ * (errata.c), which prints res= (raw) vs rmask= so the fix's effect is self-evident. */
+word_t aios_asid_residency_raw(word_t asid)
+{
+    if (likely(asid < AIOS_RESID_NASIDS)) {
+        return (word_t)armKSASIDResidency[asid];
+    }
+    return 0;
+}
+
+static inline word_t aios_asid_residency(asid_t asid)
+{
+    if (likely(asid < AIOS_RESID_NASIDS)) {
+        /* AIOS: honor only the cores distributed user work may actually run on
+         * (aios_resident_cores_mask, default {core0}). Stale boot-era bits for the
+         * idle/parked siblings are masked out so the teardown tlbi stays local. */
+        return (word_t)armKSASIDResidency[asid] & aios_resident_cores_mask;
+    }
+    /* AIOS 2026-06-20: untracked ASID (>= AIOS_RESID_NASIDS). The old default was
+     * MASK(all) = full broadcast, which the enhanced TLBI profiler caught firing
+     * ~18k times (asids climb past 2048 as processes spawn) -- every such teardown
+     * tlbi needlessly IPI'd cores 1-3 and the resulting cross-core DVM is the
+     * leading suspect for the mid-burst ~32s stall. Under core-0 pinning an
+     * untracked asid is a core-0 process, so local-only is correct. */
+    return BIT(getCurrentCPUIndex());
+}
+static inline void aios_clear_asid_residency(asid_t asid)
+{
+    if (likely(asid < AIOS_RESID_NASIDS)) {
+        armKSASIDResidency[asid] = 0;
+    }
+}
+#endif
+
+/* AIOS TLBI-stall diag: the last-unmapped page's phys addr + raw PTE, captured
+ * in unmapPage and reported by the profiler (errata.c). */
+extern volatile word_t aios_last_unmap_paddr;
+extern volatile word_t aios_last_unmap_pte;
+
+#if AIOS_LAZY_TLB_TEARDOWN
+/* Lazy-TLB teardown (see arch/machine/tlb.h): per-ASID "owes a tlbi aside1 before it next
+ * runs" flag. Set by unmapPage when it defers a non-current-ASID page flush; consumed by
+ * the next setVMRoot / fastpath switch-to that ASID (aios_flush_pending_asid, defined after
+ * invalidateTLBByASID below), or by deleteASID. Bounded to the low ASIDs AIOS uses; an
+ * out-of-range ASID is flushed eagerly in unmapPage and never deferred. Plain bytes:
+ * updated only under the big kernel lock (non-MCS). */
+#define AIOS_LAZYTLB_NASIDS 2048
+static uint8_t armKSASIDPendingFlush[AIOS_LAZYTLB_NASIDS];
+static inline void aios_asid_set_pending_flush(word_t asid)
+{
+    if (likely(asid < AIOS_LAZYTLB_NASIDS)) {
+        armKSASIDPendingFlush[asid] = 1;
+    }
+}
+static inline void aios_asid_clear_pending_flush(word_t asid)
+{
+    if (likely(asid < AIOS_LAZYTLB_NASIDS)) {
+        armKSASIDPendingFlush[asid] = 0;
+    }
+}
+#endif
