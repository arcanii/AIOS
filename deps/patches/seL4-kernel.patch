+
+    /* CPUECTLR_EL1 is an A72 (part 0xD08) IMP-DEF encoding; skip elsewhere. */
+    if (((midr >> 4) & 0xFFF) != 0xD08) {
+        printf("[A72PROBE] core=%d MIDR=%"SEL4_PRIx_word" (not A72)\n",
+               (int)core, midr);
+        return;
+    }
+
+    word_t old_vbar;
+    int trapped;
+    asm volatile("mrs %0, vbar_el1" : "=r"(old_vbar));
+    asm volatile("msr vbar_el1, %0" :: "r"((word_t)aios_probe_vtable));
+    asm volatile("isb");
+
+    word_t ectlr = aios_probe_one(aios_probe_rd_cpuectlr, &trapped);
+
+    asm volatile("msr vbar_el1, %0" :: "r"(old_vbar));
+    asm volatile("isb");
+
+    if (trapped) {
+        printf("[A72PROBE] core=%d CPUECTLR_EL1=TRAPPED\n", (int)core);
+    } else {
+        printf("[A72PROBE] core=%d CPUECTLR_EL1=%"SEL4_PRIx_word" SMPEN=%d RET=%d\n",
+               (int)core, ectlr, (int)((ectlr >> 6) & 1), (int)(ectlr & 7));
+    }
+    aios_pmu_init();   /* arm the stall-profiler PMU counters on this secondary core */
+}
+
+/* ----------------------------------------------------------------------
+ * exec-teardown TLBI-stall PROFILER (DIAGNOSTIC). The ~33s idle-teardown freeze
+ * is the unmap `tlbi vae1`+`dsb` (DVM-Sync) hanging when the BCM2711 SCB fabric
+ * has quiesced after idle. invalidateLocalTLB_VAASID (machine.h) times each
+ * tlbi+dsb and calls aios_tlbi_profile(). On a slow (>=1s) tlbi it dumps rich
+ * context to hunt a COMMON CAUSE:
+ *   core   = the stalling core.
+ *   dur    = the tlbi+dsb duration (the stall itself).
+ *   gap    = THIS core's idle-gap (ms since this core's PREVIOUS tlbi; per-core,
+ *            so it is clean -- the old single global was SMP-contaminated). Large
+ *            gap => first-tlbi-after-idle (HW fabric quiescence); small gap =>
+ *            mid-burst (would implicate a software/contention cause we can fix).
+ *   asid/va= which ASID (process) + page VA is being invalidated -- to see if
+ *            every stall is the same operation (e.g. always the dying proc).
+ *   qgap   = ms since EACH core's last tlbi = a cross-core quiescence snapshot
+ *            (are all cores dead, or is one active?). The stalling core reads 0.
+ *   ipi    = cumulative count of teardown tlbis that ACTUALLY IPI'd a remote core
+ *            (bumped in tlb.h). Tests the residency/ipi_wait theory; under core-0
+ *            pinning expect 0 => the stall is the LOCAL dsb, not the IPI barrier.
+ *   cnt    = per-core total profiled-tlbi counts.
+ * ---------------------------------------------------------------------- */
+#define AIOS_TLBISTALL_MS 1000ull
+#define AIOS_TLBI_NCORES 4
+volatile word_t aios_last_tlbi_t[AIOS_TLBI_NCORES];
+volatile word_t aios_tlbi_cnt[AIOS_TLBI_NCORES];
+volatile word_t aios_burst_start_t[AIOS_TLBI_NCORES];  /* per-core teardown-burst start tick */
+volatile word_t aios_burst_cnt[AIOS_TLBI_NCORES];      /* tlbi position within the current burst */
+volatile word_t aios_tlbistall_count;
+volatile word_t aios_tlbi_ipi_sent;   /* bumped in tlb.h on a real remote-IPI tlbi */
+volatile word_t aios_last_unmap_paddr; /* phys addr of last unmapped page (vspace.c unmapPage) */
+volatile word_t aios_last_unmap_pte;   /* raw PTE of last unmapped page */
+/* per-physical-band tlbi + stall counts. The gpu_mem/VideoCore band is the top
+ * 64MB of DRAM [0xf8000000, 0xfc000000). If lbS (low-band stalls) stays 0 while
+ * hbS climbs, the stall is EXCLUSIVELY the GPU-reserved band -> root cause locked. */
+#define AIOS_GPUBAND_LO 0xf8000000ull
+#define AIOS_GPUBAND_HI 0xfc000000ull
+volatile word_t aios_lowband_tlbi, aios_highband_tlbi;
+volatile word_t aios_lowband_stall, aios_highband_stall;
+/* AIOS per-core liveness heartbeat: idle.S stamps CNTPCT into this core's padded
+ * (64-byte, no false-share) slot every idle iteration. On a teardown stall the issuing
+ * core (in the kernel, not idling) shows a large lag; a SIBLING showing ~0 lag proves it
+ * kept running through the stall (core-LOCAL -> multi-core survives), while ~stall-duration
+ * means it froze too (cluster-WIDE). The decisive un-pinning-feasibility test. */
+volatile word_t aios_core_heartbeat[AIOS_TLBI_NCORES * 8];
+
+#ifdef ENABLE_SMP_SUPPORT
+/* AIOS session-4 residency-fix signature (definitions in arm/64 vspace.c). File-scope
+ * externs so the profiler print below can show res= (raw residency) vs rmask= (the masked
+ * cores a teardown may IPI) without a nested-extern warning. */
+extern word_t aios_resident_cores_mask;
+word_t aios_asid_residency_raw(word_t asid);
+#endif
+
+/* AIOS session-7: profiler for the NON-tlbi DVM freeze. ASID-gen removed the teardown `tlbi`
+ * (zero [TLBISTALL]) but the ~32.4s freeze persisted -> a `dsb` is waiting on a DVM-Complete
+ * from a non-tlbi op (suspect: cleanByVA_PoU `dc cvau`, awaited by the context-switch dsb).
+ * Called from setCurrentUserVSpaceRoot (machine.h). Persistent counters for /proc + a serial
+ * [DSBSTALL] print on a slow (>=1s) dsb so we can confirm WHICH barrier eats the freeze. */
+volatile word_t aios_dsbstall_count = 0;
+volatile word_t aios_dsbstall_worst_ms = 0;
+volatile word_t aios_dsb_cnt = 0;
+void aios_dsb_profile(word_t t0, word_t t1, word_t site);
+void aios_dsb_profile(word_t t0, word_t t1, word_t site)
+{
+    word_t freq;
+    asm volatile("mrs %0, cntfrq_el0" : "=r"(freq));
+    if (!freq) {
+        freq = 54000000;
+    }
+    aios_dsb_cnt++;
+    word_t dur_ms = (t1 - t0) * 1000ull / freq;
+    if (dur_ms >= 1000ull) {
+        aios_dsbstall_count++;
+        if (dur_ms > aios_dsbstall_worst_ms) {
+            aios_dsbstall_worst_ms = dur_ms;
+        }
+        printf("[DSBSTALL] site=%d dur=%dms count=%d (non-tlbi DVM freeze)\n",
+               (int)site, (int)dur_ms, (int)aios_dsbstall_count);
+    }
+}
+
+/* AIOS session-7 teardown CHECKPOINT BREADCRUMB (task #11): the ~32.4s wedge was refuted at the
+ * tlbi, the cache-clean, and the context-switch dsb -- all by ELIMINATION, never LOCALIZED. Each
+ * teardown stage records a per-core CNTPCT timestamp (a barrier-free sysreg read); if the gap since
+ * the previous checkpoint exceeds 5s, print which interval it was. A ~32.4s gap between two ADJACENT
+ * intra-teardown stages => the wedge is IN that interval (a surgical fix reopens). A ~30s gap at a
+ * teardown START (this=1/5) is the netstall idle (expected); a >40s START gap = idle + a wedge in the
+ * entry / scheduler / kernel-exit path (i.e. OUTSIDE the instrumented teardown -- fabric-fundamental).
+ * printf fires only on the rare big gap, AFTER the wedge, so it never contaminates the measured op. */
+volatile word_t aios_cp_last_stage[AIOS_TLBI_NCORES];
+volatile word_t aios_cp_last_t[AIOS_TLBI_NCORES];
+/* AIOS session-8: per-core kernel-ENTRY timestamp. Stamped when aios_checkpoint is called with
+ * stage 9 (from arch_c_entry_hook, on EVERY kernel entry -- syscall/fastpath/fault/IRQ). Core 0
+ * NEVER runs idle.S (it is saturated by prio-200 yield-spinning servers), so its idle heartbeat
+ * (aios_core_heartbeat) is always 0 -- this gives core 0 a real liveness mark. At an EXIT stage
+ * (11 slowpath / 12 fastpath), kent_lag = now - this round-trip's entry = the IN-KERNEL duration:
+ *   kent_lag ~= dur  => core 0 wedged INSIDE the kernel handler (entry -> here).
+ *   kent_lag ~= small => the handler ran fast; the wedge was BEFORE entry (the previous exit's
+ *                        eret asm / user EL0 / the exception vector). */
+volatile word_t aios_cp_kentry_t[AIOS_TLBI_NCORES];
+/* AIOS session-8: per-core PMU snapshot at the previous checkpoint, for per-INTERVAL deltas. The
+ * idle->wake wedge (the stage 11->9/10/11 gap) has NO PMU data yet -- the tlbi profiler only fires
+ * on a teardown `tlbi`, which ASID-gen removed. The delta is dominated by the ~32.4s wedge, so it
+ * reads what the core did DURING the wedge: inst_retired ~= 0 over 32.4s => CLOCKED but WEDGED on
+ * ONE instruction (a barrier) -- NOT "IRQ-not-delivered while looping" (which would retire
+ * billions). bus_access ~= 0 => a clean wait on a PARKED fabric (vs large = a retry storm).
+ * cpu_cycles is 32-bit and wraps ~7x over 32s -> noise (kept for short intervals only). */
+volatile word_t aios_cp_pmu[AIOS_TLBI_NCORES][6];
+/* AIOS session-10 (re-localize, get the address): per-core "last breadcrumb" -- the candidate
+ * addresses recorded JUST BEFORE the kernel-exit asm (restore_user_context stage 11 /
+ * fastpath_restore stage 12), so that when the NEXT checkpoint (stage 9 kernel entry) detects a
+ * >5s gap it can print WHAT core 0 was about to touch when it wedged:
+ *   regs = the TCB context base the `ldp` block restores from = the D-side cold-load candidate;
+ *   pc   = registers[NextIP] = the user PC the `eret` returns into = the I-side cold-FETCH
+ *          candidate (never tested by the bare-metal/Linux repros, which only timed D-side loads);
+ *   ttbr = TTBR0_EL1 = the user vspace base + hw ASID in [63:48] at the wedge.
+ * The wedged core never overwrites these between stage 11/12 and the stage-9 read, so the stale
+ * value IS the pre-wedge state. Pair with the PMU mem/l2/l1i deltas (which say D-load vs I-fetch
+ * vs barrier) to turn "the first fabric op after idle" into an exact instruction + address. */
+volatile word_t aios_bc_site[AIOS_TLBI_NCORES];
+volatile word_t aios_bc_regs[AIOS_TLBI_NCORES];
+volatile word_t aios_bc_pc[AIOS_TLBI_NCORES];
+volatile word_t aios_bc_ttbr[AIOS_TLBI_NCORES];
+void aios_breadcrumb(word_t site, word_t regs, word_t pc);
+void aios_breadcrumb(word_t site, word_t regs, word_t pc)
+{
+    word_t core = CURRENT_CPU_INDEX();
+    if (core >= AIOS_TLBI_NCORES) {
+        core = 0;
+    }
+    word_t ttbr;
+    asm volatile("mrs %0, ttbr0_el1" : "=r"(ttbr));
+    aios_bc_site[core] = site;
+    aios_bc_regs[core] = regs;
+    aios_bc_pc[core]   = pc;
+    aios_bc_ttbr[core] = ttbr;
+}
+void aios_checkpoint(word_t stage);
+void aios_checkpoint(word_t stage)
+{
+    word_t core = CURRENT_CPU_INDEX();
+    if (core >= AIOS_TLBI_NCORES) {
+        core = 0;
+    }
+    word_t now;
+    asm volatile("mrs %0, cntpct_el0" : "=r"(now));
+    /* Snapshot the stall-profiler PMU counters + the overflow-status flags (EL1-accessible; 0 if
+     * unarmed, e.g. QEMU a53). The A72 event counters are 32-bit and wrap every ~2.9s of solid
+     * execution, so a MASKED delta over a 32.4s interval CANNOT by itself separate "wedged" (retires
+     * ~0) from "looping" (retires billions -> wraps to an unpredictable, possibly-small remainder).
+     * The OVERFLOW flag (PMOVSCLR_EL0) is the reliable discriminator: a core wedged on one barrier
+     * never overflows INST_RETIRED; a looping core does (>=1 wrap). We clear the event-counter flags
+     * (bits 0..5, NOT bit 31 = the dedicated PMCCNTR seL4's cpuacct uses) at the end of every
+     * checkpoint, so the flag read here reflects overflows in EXACTLY the just-elapsed interval. */
+    word_t pm[6], ovf;
+    asm volatile("mrs %0, S3_3_C14_C8_0" : "=r"(pm[0]));   /* INST_RETIRED */
+    asm volatile("mrs %0, S3_3_C14_C8_1" : "=r"(pm[1]));   /* BUS_ACCESS   */
+    asm volatile("mrs %0, S3_3_C14_C8_2" : "=r"(pm[2]));   /* MEM_ACCESS   */
+    asm volatile("mrs %0, S3_3_C14_C8_3" : "=r"(pm[3]));   /* L2D_CACHE_REFILL */
+    asm volatile("mrs %0, S3_3_C14_C8_4" : "=r"(pm[4]));   /* CPU_CYCLES   */
+    asm volatile("mrs %0, S3_3_C14_C8_5" : "=r"(pm[5]));   /* L1I_CACHE_REFILL */
+    asm volatile("mrs %0, S3_3_C9_C12_3" : "=r"(ovf));     /* PMOVSCLR_EL0 (overflow status) */
+    word_t prev_t = aios_cp_last_t[core];
+    word_t prev_s = aios_cp_last_stage[core];
+    if (prev_t) {
+        word_t freq;
+        asm volatile("mrs %0, cntfrq_el0" : "=r"(freq));
+        if (!freq) {
+            freq = 54000000;
+        }
+        word_t dur_ms = (now - prev_t) * 1000ull / freq;
+        if (dur_ms >= 5000ull) {
+            /* idle_lag: staleness of THIS core's idle.S heartbeat (idle cores -- ~= dur if they
+             * blocked on the BKL through the freeze, ~= 0 if the idle loop kept running). Core 0
+             * never idles => -1. */
+            word_t ih = aios_core_heartbeat[core * 8];
+            int idle_lag = ih ? (int)((now - ih) * 1000ull / freq) : -1;
+            /* kent_lag: ms since this core's last kernel entry (see aios_cp_kentry_t above). */
+            word_t ke = aios_cp_kentry_t[core];
+            int kent_lag = ke ? (int)((now - ke) * 1000ull / freq) : -1;
+            /* PMU over the interval. The OVERFLOW flags are the reliable read; the masked deltas
+             * corroborate only when no wrap occurred:
+             *   iovf=0 AND inst small => WEDGED on ONE instruction (retired < 2^32, no wrap).
+             *   iovf=1 (or inst large) => the core was LOOPING/active (retired billions) -- e.g. an
+             *     idle/BKL-spinning sibling, NOT the primary wedge. bus ~=0 + bovf=0 => parked fabric. */
+            int d_inst = (int)((pm[0] - aios_cp_pmu[core][0]) & 0xffffffffu);
+            int d_bus  = (int)((pm[1] - aios_cp_pmu[core][1]) & 0xffffffffu);
+            int d_mem  = (int)((pm[2] - aios_cp_pmu[core][2]) & 0xffffffffu);
+            int d_l2   = (int)((pm[3] - aios_cp_pmu[core][3]) & 0xffffffffu);
+            int d_cyc  = (int)((pm[4] - aios_cp_pmu[core][4]) & 0xffffffffu);
+            int d_l1i  = (int)((pm[5] - aios_cp_pmu[core][5]) & 0xffffffffu);
+            int iovf = (int)(ovf & 1u);          /* INST_RETIRED (cnt0) overflowed this interval? */
+            int bovf = (int)((ovf >> 1) & 1u);   /* BUS_ACCESS   (cnt1) overflowed this interval?  */
+            /* session-10 additions -- the nature of the wedged instruction, MEASURED not inferred:
+             *   mem/movf  (MEM_ACCESS, cnt2): data memory accesses retired. ~0 + movf=0 => the wedge
+             *     is NOT a data load/store (=> I-side fetch or a barrier).
+             *   l2/l2ovf  (L2D_CACHE_REFILL, cnt3): a D-side line-fill happened. ==1 => exactly one
+             *     fill in the whole interval = a cold D-LOAD that hung mid-fill (the s8 hypothesis).
+             *   l1i/iiovf (L1I_CACHE_REFILL, cnt5): an I-side line-fill happened. ==1 + mem=0 =>
+             *     the wedge is a cold INSTRUCTION FETCH (e.g. the user PC after eret) -- the
+             *     candidate the EL2-only / D-load-only repros structurally could not test.
+             *   cyovf (CPU_CYCLES, cnt4 bit4): did the cycle counter wrap? At >=600MHz a CLOCKED core
+             *     wraps ~5-8x over 32.4s => cyovf=1 = CLOCKED-but-pipeline-stalled (a true memory
+             *     wedge). cyovf=0 with tiny cyc => the core was CLOCK-GATED (retention), not stalled
+             *     on a bus op -- which would overturn the whole "wedged on a fabric op" reading. */
+            int movf  = (int)((ovf >> 2) & 1u);  /* MEM_ACCESS       (cnt2) overflowed? */
+            int l2ovf = (int)((ovf >> 3) & 1u);  /* L2D_CACHE_REFILL (cnt3) overflowed? */
+            int cyovf = (int)((ovf >> 4) & 1u);  /* CPU_CYCLES       (cnt4) overflowed? (CLOCKED vs gated) */
+            int iiovf = (int)((ovf >> 5) & 1u);  /* L1I_CACHE_REFILL (cnt5) overflowed? */
+            /* session-8 cluster-survival A/B oracle: idle.S heartbeat lag of ALL cores. On a core-0
+             * wedge, allidle[1..3]~=0 => siblings stayed alive in idle.S (the AIOS_SIBLING_TIMER_MASK
+             * circumvention worked); ~=dur => they blocked on the BKL (the old cascade). */
+            int allidle[AIOS_TLBI_NCORES];
+            for (int c = 0; c < AIOS_TLBI_NCORES; c++) {
+                word_t h = aios_core_heartbeat[c * 8];
+                /* clamp h>=now (a sibling stamping CONCURRENTLY with this core's `now` read =
+                 * alive) to 0 instead of letting (now-h) underflow to garbage. So ALIVE prints a
+                 * clean 0, BLOCKED prints ~dur, never-idled prints -1. */
+                allidle[c] = h ? (now > h ? (int)((now - h) * 1000ull / freq) : 0) : -1;
+            }
+            printf("[STAGECP] core=%d prev=%d this=%d dur=%dms idle_lag=%dms kent_lag=%dms"
+                   " pmu=[inst=%d iovf=%d bus=%d bovf=%d mem=%d movf=%d l2=%d l2ovf=%d"
+                   " l1i=%d iiovf=%d cyc=%d cyovf=%d]"
+                   " bc=[s=%d regs=0x%"SEL4_PRIx_word" pc=0x%"SEL4_PRIx_word" ttbr=0x%"SEL4_PRIx_word"]"
+                   " allidle=[%d,%d,%d,%d]\n",
+                   (int)core, (int)prev_s, (int)stage, (int)dur_ms,
+                   idle_lag, kent_lag,
+                   d_inst, iovf, d_bus, bovf, d_mem, movf, d_l2, l2ovf,
+                   d_l1i, iiovf, d_cyc, cyovf,
+                   (int)aios_bc_site[core], aios_bc_regs[core], aios_bc_pc[core], aios_bc_ttbr[core],
+                   allidle[0], allidle[1], allidle[2], allidle[3]);
+        }
+    }
+    aios_cp_last_t[core] = now;
+    aios_cp_last_stage[core] = stage;
+    aios_cp_pmu[core][0] = pm[0];
+    aios_cp_pmu[core][1] = pm[1];
+    aios_cp_pmu[core][2] = pm[2];
+    aios_cp_pmu[core][3] = pm[3];
+    aios_cp_pmu[core][4] = pm[4];
+    aios_cp_pmu[core][5] = pm[5];
+    /* Clear the event-counter overflow flags (bits 0..5 only; bit 31 = the dedicated cycle counter
+     * PMCCNTR that seL4's cpuacct reads is left untouched) so the next checkpoint's ovf read is
+     * per-interval. NOTE: cnt4 (bit 4) is the EVENT-counter CPU_CYCLES, distinct from PMCCNTR/bit31
+     * -- clearing bit 4 is what makes cyovf a clean per-interval CLOCKED-vs-gated flag. */
+    asm volatile("msr S3_3_C9_C12_3, %0" :: "r"((word_t)0x3f));
+    if (stage == 9) {
+        aios_cp_kentry_t[core] = now;   /* kernel-entry mark, read as kent_lag at the next exit */
+    }
+}
+
+void aios_tlbi_profile(word_t t0, word_t t1, word_t mva_plus_asid, const word_t *pm0, const word_t *pm1);
+void aios_tlbi_profile(word_t t0, word_t t1, word_t mva_plus_asid, const word_t *pm0, const word_t *pm1)
+{
+    word_t freq;
+    asm volatile("mrs %0, cntfrq_el0" : "=r"(freq));
+    if (!freq) {
+        freq = 54000000;
+    }
+    word_t core = CURRENT_CPU_INDEX();
+    if (core >= AIOS_TLBI_NCORES) {
+        core = 0;
+    }
+    word_t gap_ticks = t0 - aios_last_tlbi_t[core];
+    aios_last_tlbi_t[core] = t1;
+    aios_tlbi_cnt[core]++;
+    /* per-core BURST tracking: a gap > 100ms ends a burst (a real idle between
+     * teardowns; within a burst gaps are <1ms). bpos/bms then show WHERE in the
+     * teardown burst the stall hangs -- always the Nth tlbi, or Mms in? */
+    if (gap_ticks > freq / 10) {
+        aios_burst_start_t[core] = t0;
+        aios_burst_cnt[core] = 0;
+    } else {
+        aios_burst_cnt[core]++;
+    }
+    int hb = (aios_last_unmap_paddr >= AIOS_GPUBAND_LO
+              && aios_last_unmap_paddr < AIOS_GPUBAND_HI);
+    if (hb) { aios_highband_tlbi++; } else { aios_lowband_tlbi++; }
+    word_t dur_ms = (t1 - t0) * 1000ull / freq;
+    if (dur_ms >= AIOS_TLBISTALL_MS) {
+        aios_tlbistall_count++;
+        if (hb) { aios_highband_stall++; } else { aios_lowband_stall++; }
+        word_t gap_ms = gap_ticks * 1000ull / freq;
+        word_t burst_ms = (t1 - aios_burst_start_t[core]) * 1000ull / freq;
+        word_t asid = mva_plus_asid >> 48;
+        word_t va = (mva_plus_asid & 0xFFFFFFFFFFFFull) << 12;
+        /* AIOS session-4 residency-fix signature: res = the RAW per-ASID core-residency
+         * bitmap; rmask = the cores a shootdown may IPI (the fix's mask, default 0x1). On
+         * the stalling asid=1 these read res=0xf rmask=0x1 -> the teardown stays core-LOCAL
+         * (no IPI to the idle siblings), so ipi STOPS climbing and hb_ms[1,2,3]~=0. The
+         * extern decls are at file scope (above) to avoid a nested-extern warning. */
+#ifdef ENABLE_SMP_SUPPORT
+        unsigned res = (unsigned)aios_asid_residency_raw(asid);
+        unsigned rmask = (unsigned)aios_resident_cores_mask;
+#else
+        unsigned res = 0, rmask = 1;
+#endif
+        int qg[AIOS_TLBI_NCORES];
+        for (int c = 0; c < AIOS_TLBI_NCORES; c++) {
+            qg[c] = (int)((t1 - aios_last_tlbi_t[c]) * 1000ull / freq);
+        }
+        /* PMU deltas across the tlbi+dsb (what the wedged core did): inst~=0 + cyc large
+         * => clocked but stuck on ONE instruction (the dsb); bus~=0 => a clean wait on a
+         * PARKED fabric, vs large => a retry storm (a different bug). 32-bit counters masked
+         * to their mod-2^32 delta -- a large value may have wrapped, but ~0-vs-large holds. */
+        int d_inst = (int)((pm1[0] - pm0[0]) & 0xffffffffu);
+        int d_bus  = (int)((pm1[1] - pm0[1]) & 0xffffffffu);
+        int d_mem  = (int)((pm1[2] - pm0[2]) & 0xffffffffu);
+        int d_l2   = (int)((pm1[3] - pm0[3]) & 0xffffffffu);
+        int d_cyc  = (int)((pm1[4] - pm0[4]) & 0xffffffffu);
+        /* per-core heartbeat lag (ms since each core last stamped idle.S); a SIBLING ~=0 =
+         * alive through the stall (core-LOCAL), ~=dur = froze too; -1 = never idled. */
+        int hbl[AIOS_TLBI_NCORES];
+        for (int c = 0; c < AIOS_TLBI_NCORES; c++) {
+            word_t h = aios_core_heartbeat[c * 8];
