+     * confirm the HARDWARE ASID width before recycling hw asids by generation. TCR_EL1.AS
+     * (bit 36): 0 => 8-bit ASIDs (only 255 hw asids => frequent generation wraps), 1 =>
+     * 16-bit (65535 hw asids => wraps ~never). The elfloader sets TCR_ASID16 (mmu.S), so we
+     * expect AS=1 -> AIOS_HWASID_MAX=0xFFFF. TCR_EL1 is architectural and readable at EL1
+     * (Pi non-hyp) and EL2 (QEMU hyp), so this prints on BOTH builds and is core-agnostic
+     * (printed before the A72-only guard below). */
+    {
+        word_t tcr_el1 = 0;
+        asm volatile("mrs %0, tcr_el1" : "=r"(tcr_el1));
+        int as = (int)((tcr_el1 >> 36) & 1);
+        printf("[ASIDGEN] TCR_EL1=%"SEL4_PRIx_word" AS=%d (%d-bit hw ASID)\n",
+               tcr_el1, as, as ? 16 : 8);
+    }
