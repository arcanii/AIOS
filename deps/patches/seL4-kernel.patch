+     * differ on other cores. Skip elsewhere so the probe is safe everywhere. */
+    if (((midr >> 4) & 0xFFF) != 0xD08) {
+        printf("[A72PROBE] MIDR=%"SEL4_PRIx_word" (not A72, skipping)\n", midr);
+        return;
+    }
