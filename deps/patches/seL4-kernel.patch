+     * beacon (cacheable cross-core RMW), dsb-less tlbi, and tlbi+dsb ish (the
+     * Linux-exact pattern) ALL stalled identically. No CPU-generated traffic
+     * holds the external snoop interface active -- cache snoops stay intra-
+     * cluster (SCU) and never reach the ACE port; warming needs a coherent
+     * external bus-master (DMA), which Pi4 peripherals do not provide. WFI is
+     * kept OFF only because it deepened the quiescence (made the stall worse).
+     * The real cure is the AIOS-vs-Linux coherency/retention-config diff; see
+     * docs/NEXT_20260620_dvm_heartbeat.md. */
+1:
+    yield
+    /* AIOS per-core liveness heartbeat (diagnostic): stamp CNTPCT into this core's padded
+       64-byte slot (aios_core_heartbeat, errata.c) every idle iteration. The TLBI-stall
+       profiler then reports, after a core-0 teardown stall, whether THIS core kept running
+       through the ~32.4s (sibling lag ~=0 => core-LOCAL => a watchdog core survives) or
+       also froze (lag ~=dur => cluster-WIDE). Each core owns its own cache line, so these
+       stores generate NO cross-core snoop traffic (unlike the refuted corewarm). The idle
+       loop never returns, so clobbering x0-x2 is free. */
+    mrs x0, mpidr_el1
+    and x0, x0, #0xff
+    adrp x1, aios_core_heartbeat
+    add x1, x1, #:lo12:aios_core_heartbeat
+    add x1, x1, x0, lsl #6          /* x1 = &aios_core_heartbeat[core*8] (core*64 bytes) */
+    mrs x2, cntpct_el0
+    str x2, [x1]
     b 1b
 END_FUNC(idle_thread)
