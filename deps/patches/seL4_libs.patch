diff --git a/libsel4muslcsys/src/sys_morecore.c b/libsel4muslcsys/src/sys_morecore.c
index ade41c8..4c595ee 100644
--- a/libsel4muslcsys/src/sys_morecore.c
+++ b/libsel4muslcsys/src/sys_morecore.c
@@ -82,8 +82,8 @@ long sys_mmap_impl(void *addr, size_t length, int prot, int flags, int fd, off_t
 
 long sys_mremap(va_list ap)
 {
-    assert(!"not implemented");
-    return -ENOMEM;
+    (void)ap;
+    return (long)-12;
 }
 
 #else
@@ -372,7 +372,14 @@ long sys_mmap2(va_list ap)
 
 long sys_munmap(va_list ap)
 {
-    ZF_LOGE("%s is unsupported. This may have been called due to a "
-            "large malloc'd region being free'd.", __func__);
+    void *addr = va_arg(ap, void *);
+    size_t length = va_arg(ap, size_t);
+    uintptr_t a = (uintptr_t)addr;
+    /* Reclaim if this is the top-most mmap region (LIFO order).
+     * mmap grows morecore_top downward; munmap can push it back up
+     * if the freed region is exactly at morecore_top. */
+    if (a == morecore_top && length > 0) {
+        morecore_top += length;
+    }
     return 0;
 }
